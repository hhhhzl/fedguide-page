{
  "metadata": {
    "title": "FedGuide: Diffusion Prior Alignment and Value Baseline Guidance for Heterogeneous Federated Reinforcement Learning",
    "authors": [
      "Zhilin He",
      "Gauri Joshi"
    ],
    "affiliation": "Carnegie Mellon University",
    "seedCount": 5,
    "seeds": [
      0,
      1,
      2,
      3,
      4
    ],
    "roundCount": 100,
    "expertCount": 8,
    "metric": "Client-average evaluation return",
    "finalDefinition": "For each seed, average client-average evaluation return over the last 10 communication rounds; report the mean and sample standard deviation across five seeds.",
    "worstSeedDefinition": "Minimum across the five seeds of each seed's last-10-round mean client-average evaluation return.",
    "cvDefinition": "Average across seeds of the within-seed sample standard deviation over the last 20 rounds, divided by the absolute final mean return. Lower is better.",
    "curveDefinition": "Mean across five seeds with shaded plus/minus one standard error, using trailing-mean smoothing. Window 5 for all methods, except FedAvg and FedKL use window 1 on Reacher, Hopper, Walker2D and HalfCheetah, including their hard variants. Reacher-Hard uses a symmetric-logarithmic return axis with a linear threshold of 10; aggregation is performed before the axis transform.",
    "rawHistoryMetric": "metrics_distributed_fit[\"eval/return\"]",
    "sourceFiles": [
      "latex/latex_fedguide/tex/results_table.tex",
      "latex/latex_fedguide/tex/fg_family_table.tex",
      "scripts/viz/compute_table_metrics.py",
      "scripts/viz/compute_fg_family_table.py",
      "scripts/viz/plot_posttrain.py",
      "scripts/viz/plot_ablation_hard.py",
      "latex/latex_fedguide/tex/ablation_results.tex"
    ],
    "verification": "Recomputed from the existing training_history.pkl files. Rounded values match the paper tables. All 63 environment-method combinations (five main and four hard benchmarks, seven methods) have five seeds and 100 common evaluation rounds.",
    "sourceLabelNotes": [
      "The paper results-table caption calls W worst-round; the executable metric definition is worst-seed as documented here.",
      "The paper curve caption says one standard deviation; the plotting code computes one standard error, documented here."
    ],
    "qualitativeSelection": "Final-round qualitative rollouts select the best available seed per environment and method using last-10-round evaluation return. Quantitative results average five seeds.",
    "hardSuiteDefinition": "Four stronger-heterogeneity benchmarks from the paper's hard ablation: Reacher-Hard (ablation C), Hopper-Hard, Walker2D-Hard and HalfCheetah-Hard. The experimental protocol fixes eight clients, five seeds and 100 communication rounds."
  },
